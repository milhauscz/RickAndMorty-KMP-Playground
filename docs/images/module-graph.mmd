%%{init: {"flowchart": {"defaultRenderer": "elk", "htmlLabels": true, "curve": "linear"}}}%%
flowchart TB
    shared[":shared"]

    subgraph impl_row [" "]
        direction LR
        charsImpl[":feature:characters:impl"]
        epImpl[":feature:episode:impl"]
        locImpl[":feature:location:impl"]
    end

    subgraph api_row [" "]
        direction LR
        charsApi[":feature:characters:api"]
        epApi[":feature:episode:api"]
        locApi[":feature:location:api"]
    end

    shared --> charsImpl
    shared --> epImpl
    shared --> locImpl

    charsImpl --> charsApi
    epImpl --> epApi
    locImpl --> locApi

    charsApi --> epApi
    charsApi --> locApi

    style impl_row fill:none,stroke:none,color:transparent
    style api_row fill:none,stroke:none,color:transparent
